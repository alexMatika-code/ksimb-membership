@page "/login"

@using System.ComponentModel.DataAnnotations
@using ksimb_membership.Modules.Members

<PageTitle>Prijava</PageTitle>

<div class="security-page">
    <div class="security-card">

        <div class="security-icon">
            <i class="ph ph-identification-card"></i>
        </div>

        <h1>Prijava</h1>

        <p class="text-secondary">
            Unesi svoj OIB za pristup svom profilu.
        </p>

        <form method="post"
              action="/auth/user-sign-in"
              data-enhance="false">

            <AntiforgeryToken/>

            <div class="mb-4">

                <label for="oib"
                       class="form-label">
                    OIB
                </label>

                <div class="input-group input-group-lg">

                    <span class="input-group-text">
                        <i class="ph ph-identification-card"></i>
                    </span>

                    <input id="oib"
                           name="OIB"
                           class="form-control"
                           maxlength="11"
                           inputmode="numeric"
                           placeholder="Unesi OIB"
                           @bind="_model.Oib"/>

                </div>

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="alert alert-danger d-flex align-items-center gap-2 mt-2">
                        <i class="ph ph-warning-circle"></i>

                        <span>
                            @_errorMessage
                        </span>
                    </div>
                }

                <button type="submit"
                        class="btn primary-button btn-lg w-100 mt-3"
                        disabled="@_isSubmitting">

                    @if (_isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Prijava...</span>
                    }
                    else
                    {
                        <span>Prijavi se</span>
                    }

                </button>

                <div class="text-center mt-4">

                    <span class="text-secondary">
                        Nisi član?
                    </span>

                    <a href="@PageRoutes.Register"
                       class="text-decoration-none fw-semibold ms-1">
                        Učlani se
                    </a>

                </div>

            </div>

        </form>

    </div>
</div>

@code {

    private LoginModel _model = new();

    private bool _isSubmitting;
    private string? _errorMessage;

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "OIB je obavezan.")]
        [OIB(ErrorMessage = "Unesite ispravan OIB.")]
        public string Oib { get; set; } = string.Empty;
    }

}