@page "/profile/{MemberId:guid}"

@using ksimb_membership.Modules
@using ksimb_membership.Modules.Members

<PageTitle>Moj profil</PageTitle>

<div class="profile-page mh-100 py-4">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">

                @if (_member is null)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary mb-3"
                             role="status">
                        </div>

                        <p class="text-secondary mb-0">
                            Učitavanje profila...
                        </p>
                    </div>
                }
                else
                {
                    <div class="profile-card">

                        <div class="text-center mb-4">
                            <div class="profile-avatar">
                                <i class="ph ph-user"></i>
                            </div>

                            <h2 class="h4 fw-bold mb-1">
                                @_member.FullName
                            </h2>

                            <span class="@GetStatusClass(_member.Status) p-2">
                                @GetStatusText(_member.Status)
                            </span>
                        </div>

                        <hr class="my-4"/>

                        <div class="profile-info">

                            <div class="profile-info-item">
                                <div class="profile-info-icon">
                                    <i class="ph ph-envelope"></i>
                                </div>

                                <div>
                                    <div class="profile-info-label">
                                        Email
                                    </div>

                                    <div class="profile-info-value">
                                        @_member.Email
                                    </div>
                                </div>
                            </div>

                            <div class="profile-info-item">
                                <div class="profile-info-icon">
                                    <i class="ph ph-phone"></i>
                                </div>

                                <div>
                                    <div class="profile-info-label">
                                        Telefon
                                    </div>

                                    <div class="profile-info-value">
                                        @_member.PhoneNumber
                                    </div>
                                </div>
                            </div>

                            <div class="profile-info-item">
                                <div class="profile-info-icon">
                                    <i class="ph ph-identification-card"></i>
                                </div>

                                <div>
                                    <div class="profile-info-label">
                                        OIB
                                    </div>

                                    <div class="profile-info-value">
                                        @_member.PersonalIdentityNumber
                                    </div>
                                </div>
                            </div>

                            <div class="profile-info-item">
                                <div class="profile-info-icon">
                                    <i class="ph ph-graduation-cap"></i>
                                </div>

                                <div>
                                    <div class="profile-info-label">
                                        Fakultet
                                    </div>

                                    <div class="profile-info-value">
                                        @_member.College
                                    </div>
                                </div>
                            </div>

                            <div class="profile-info-item">
                                <div class="profile-info-icon">
                                    <i class="ph ph-cake"></i>
                                </div>

                                <div>
                                    <div class="profile-info-label">
                                        Datum rođenja
                                    </div>

                                    <div class="profile-info-value">
                                        @_member.DateOfBirth.ToString("dd.MM.yyyy.")
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>
                    @if (_currentUser is not null)
                    {
                        if (_currentUser.IsAdmin)
                        {
                            <div class="mt-3">
                                <button class="btn btn-outline-primary w-100"
                                        @onclick="@(() => NavigationManager.NavigateTo($"admin/members/{_currentUser.Id}"))">
                                    <i class="ph ph-users-three me-2"></i>
                                    Svi članovi
                                </button>
                            </div>

                            if (MemberId != _currentUser.Id)
                            {
                                <div class="mt-2 d-flex align-items-center justify-content-between gap-1">
                                    @if (_member.IsAdmin)
                                    {
                                        <button class="btn btn-warning w-100"
                                                @onclick="Demote">
                                            <i class="ph ph-arrow-up me-2"></i>
                                            Makni prava
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-warning w-100"
                                                @onclick="Promote">
                                            <i class="ph ph-arrow-up me-2"></i>
                                            Promoviraj
                                        </button>
                                    }

                                    <button class="btn btn-danger w-100"
                                            @onclick="Delete">
                                        <i class="ph ph-trash me-2"></i>
                                        Obriši
                                    </button>
                                </div>
                            }
                        }
                    }
                }

            </div>
        </div>
    </div>
</div>

@code {

    [Parameter] public Guid MemberId { get; set; }

    [Inject] private IMembersService MembersService { get; set; } = null!;

    [Inject] private ICurrentUserService CurrentUserService { get; set; } = null!;

    [Inject] private NavigationManager NavigationManager { get; set; } = null!;
    private Member? _member;

    private Member? _currentUser;
    private bool _isDeleteVisible;

    protected override async Task OnInitializedAsync()
    {
        var id = CurrentUserService.GetCurrentUser();
        if (id.HasValue)
        {
            _currentUser = await MembersService.GetMemberById(id.Value);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _member = await MembersService.GetMemberById(MemberId);
    }

    private static string GetStatusClass(MembershipStatus status)
    {
        return status switch
        {
            MembershipStatus.Active => "badge text-bg-success",
            MembershipStatus.Pending => "badge text-bg-warning",
            MembershipStatus.Denied => "badge text-bg-danger",
            _ => "badge text-bg-secondary"
        };
    }

    private static string GetStatusText(MembershipStatus status)
    {
        return status switch
        {
            MembershipStatus.Active => "Aktivan član",
            MembershipStatus.Pending => "Čeka odobrenje",
            MembershipStatus.Denied => "Odbijeno",
            _ => status.ToString()
        };
    }

    private async Task Promote()
    {
        _member = await MembersService.UpdateAdminStatus(MemberId, true);
    }

    private async Task Demote()
    {
        _member = await MembersService.UpdateAdminStatus(MemberId, false);
    }

    private async Task Delete()
    {
        _isDeleteVisible = true;
    }

}