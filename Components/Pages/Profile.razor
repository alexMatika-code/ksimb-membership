@page "/profile/{MemberId:guid}"

@using System.Security.Claims
@using Humanizer
@using ksimb_membership.Components.Components
@using ksimb_membership.Modules.Members
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Moj profil</PageTitle>

<div class="profile-page mh-100 py-4">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">

                @if (_member is null)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary mb-3"
                             role="status">
                        </div>

                        <p class="text-secondary mb-0">
                            Učitavanje profila...
                        </p>
                    </div>
                }
                else
                {
                    <div class="profile-card">

                        <div class="text-center mb-4">
                            <div class="profile-avatar">
                                <i class="ph ph-user"></i>
                            </div>

                            <h2 class="h4 fw-bold mb-1">
                                @_member.FullName
                            </h2>

                            <span class="@GetStatusClass(_member.Status) p-2">
                                @GetStatusText(_member.Status)
                            </span>
                            @if (_member.Status is MembershipStatus.Pending)
                            {
                                <div class="mt-2 border-warning-subtle">
                                    Javi nam se u klubu za potvrdu članstva
                                </div>
                            }
                        </div>

                        <hr class="my-4"/>

                        <div class="profile-info">

                            <div class="profile-info-item">
                                <div class="profile-info-icon">
                                    <i class="ph ph-envelope"></i>
                                </div>

                                <div>
                                    <div class="profile-info-label">
                                        Email
                                    </div>

                                    <div class="profile-info-value">
                                        @_member.Email
                                    </div>
                                </div>
                            </div>

                            <div class="profile-info-item">
                                <div class="profile-info-icon">
                                    <i class="ph ph-phone"></i>
                                </div>

                                <div>
                                    <div class="profile-info-label">
                                        Telefon
                                    </div>

                                    <div class="profile-info-value">
                                        @_member.PhoneNumber
                                    </div>
                                </div>
                            </div>

                            <div class="profile-info-item">
                                <div class="profile-info-icon">
                                    <i class="ph ph-identification-card"></i>
                                </div>

                                <div>
                                    <div class="profile-info-label">
                                        OIB
                                    </div>

                                    <div class="profile-info-value">
                                        @_member.PersonalIdentityNumber
                                    </div>
                                </div>
                            </div>

                            <div class="profile-info-item">
                                <div class="profile-info-icon">
                                    <i class="ph ph-graduation-cap"></i>
                                </div>

                                <div>
                                    <div class="profile-info-label">
                                        Fakultet
                                    </div>

                                    <div class="profile-info-value">
                                        @_member.College.Humanize()
                                    </div>
                                </div>
                            </div>

                            <div class="profile-info-item">
                                <div class="profile-info-icon">
                                    <i class="ph ph-cake"></i>
                                </div>

                                <div>
                                    <div class="profile-info-label">
                                        Datum rođenja
                                    </div>

                                    <div class="profile-info-value">
                                        @_member.DateOfBirth.ToString("dd.MM.yyyy.")
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>
                    if (_isAdmin)
                    {
                        <div class="mt-3">
                            <button class="btn btn-outline-primary w-100"
                                    @onclick="@(() => NavigationManager.NavigateTo($"admin/members/{_currentUserId}"))">
                                <i class="ph ph-users-three me-2"></i>
                                Svi članovi
                            </button>
                        </div>

                        if (MemberId != _currentUserId)
                        {
                            <div class="mt-2 d-flex align-items-center justify-content-between gap-1">
                                @if (_member.IsAdmin)
                                {
                                    <button
                                        class="btn btn-warning w-100 d-flex justify-content-center align-items-center gap-1"
                                        @onclick="Demote">
                                        <i class="ph ph-arrow-down me-2"></i>
                                        Makni prava
                                    </button>
                                }
                                else
                                {
                                    <button
                                        class="btn btn-warning w-100 d-flex justify-content-center align-items-center gap-1"
                                        @onclick="Promote">
                                        <i class="ph ph-arrow-up me-2"></i>
                                        Promoviraj
                                    </button>
                                }

                                <button
                                    class="btn btn-danger w-100 d-flex justify-content-center align-items-center gap-1"
                                    @onclick="Delete">
                                    <i class="ph ph-trash me-2"></i>
                                    Obriši
                                </button>
                            </div>
                        }
                    }
                }

            </div>
        </div>
    </div>
</div>

<ConfirmationModal
    @bind-IsVisible="_isDeleteVisible"
    Title="Obriši člana"
    Message="@($"Jeste li sigurni da želite obrisati člana {_member?.FullName}? Ova radnja se ne može poništiti.")"
    ConfirmText="Obriši"
    OnConfirm="DeleteConfirmed"/>

@code {

    [Parameter] public Guid MemberId { get; set; }

    [Inject] private IMembersService MembersService { get; set; } = null!;

    [Inject] private NavigationManager NavigationManager { get; set; } = null!;

    [Inject] private AuthenticationStateProvider AuthenticationStateProvider { get; set; } = null!;

    private Member? _member;

    private bool _isDeleteVisible;
    private bool _isAdmin;
    private Guid? _currentUserId;

    protected override async Task OnParametersSetAsync()
    {
        _member = await MembersService.GetMemberById(MemberId);

        var authState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true &&
            user.IsInRole("Admin"))
        {
            _isAdmin = true;

            var userId = user.FindFirstValue(
                ClaimTypes.NameIdentifier);

            if (Guid.TryParse(userId, out var currentUserId))
            {
                _currentUserId = currentUserId;
            }
        }
    }

    private static string GetStatusClass(MembershipStatus status)
    {
        return status switch
        {
            MembershipStatus.Active => "badge text-bg-success",
            MembershipStatus.Pending => "badge text-bg-warning",
            MembershipStatus.Denied => "badge text-bg-danger",
            _ => "badge text-bg-secondary"
        };
    }

    private static string GetStatusText(MembershipStatus status)
    {
        return status switch
        {
            MembershipStatus.Active => "Aktivan član",
            MembershipStatus.Pending => "Čeka odobrenje",
            MembershipStatus.Denied => "Odbijeno",
            _ => status.ToString()
        };
    }

    private async Task Promote()
    {
        _member = await MembersService.UpdateAdminStatus(MemberId, true);
    }

    private async Task Demote()
    {
        _member = await MembersService.UpdateAdminStatus(MemberId, false);
    }

    private Task Delete()
    {
        _isDeleteVisible = true;
        return Task.CompletedTask;
    }

    private async Task DeleteConfirmed()
    {
        if (_member is null)
        {
        return;
        }

        await MembersService.DeleteMember(_member.Id);

        NavigationManager.NavigateTo($"admin/members/{_currentUserId}");
    }

}