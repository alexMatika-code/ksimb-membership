@page "/volonteri"

<PageTitle>Volontiranje</PageTitle>

<div class="volunteers-page">

    <section class="volunteer-hero">
        <div class="container">

            <div class="row justify-content-center">
                <div class="col-12 col-lg-9">

                    <div class="volunteer-hero-content text-center">

                        <div class="volunteer-hero-icon">
                            <i class="ph ph-beer-bottle"></i>
                        </div>

                        <div class="volunteer-eyebrow">
                            Uključi se
                        </div>

                        <h1>
                            Postani dio naše ekipe
                        </h1>

                        <p class="volunteer-hero-description">
                            Klub nisu samo događaji i aktivnosti.
                            Klub čine ljudi koji ih zajedno stvaraju.
                            Ako želiš upoznati novu ekipu, steći iskustvo
                            i aktivno sudjelovati u radu kluba,
                            pridruži nam se kao volonter.
                        </p>
                    </div>

                </div>
            </div>

        </div>
    </section>

    <section class="volunteer-section">
        <div class="container">

            <div class="section-heading text-center">
                <span class="section-eyebrow">
                    Više od volontiranja
                </span>

                <h2>
                    Zašto se uključiti?
                </h2>

                <p>
                    Volontiranje je prilika da budeš aktivan dio kluba,
                    upoznaš ljude i sudjeluješ u stvaranju novih projekata.
                </p>
            </div>


            <div class="row g-3 g-md-4">

                <div class="col-12 col-md-4">
                    <div class="benefit-card">

                        <div class="benefit-icon">
                            <i class="ph ph-users-three"></i>
                        </div>

                        <h3>
                            Upoznaj ekipu
                        </h3>

                        <p>
                            Upoznaj druge članove, radi zajedno s ekipom
                            i postani aktivan dio klupske zajednice.
                        </p>

                    </div>
                </div>


                <div class="col-12 col-md-4">
                    <div class="benefit-card">

                        <div class="benefit-icon">
                            <i class="ph ph-lightbulb"></i>
                        </div>

                        <h3>
                            Stekni iskustvo
                        </h3>

                        <p>
                            Isprobaj nove stvari, razvij svoje vještine
                            i stekni praktično iskustvo kroz stvarne projekte.
                        </p>

                    </div>
                </div>


                <div class="col-12 col-md-4">
                    <div class="benefit-card">

                        <div class="benefit-icon">
                            <i class="ph ph-confetti"></i>
                        </div>

                        <h3>
                            Stvaraj s nama
                        </h3>

                        <p>
                            Sudjeluj u idejama, projektima i događajima
                            koji čine klub boljim i zanimljivijim.
                        </p>

                    </div>
                </div>

            </div>

        </div>
    </section>

    <section id="sto-radimo"
             class="volunteer-section volunteer-section-alt">

        <div class="container">

            <div class="section-heading">
                <span class="section-eyebrow">
                    Tvoja uloga
                </span>

                <h2>
                    Što rade naši volonteri?
                </h2>

                <p>
                    Ne moraš imati prethodno iskustvo.
                    Bitni su volja, interes i želja da se uključiš.
                </p>
            </div>


            <div class="volunteer-roles">

                @* ORGANIZACIJA DOGAĐAJA *@
                <div class="role-card">

                    <div class="role-icon">
                        <i class="ph ph-calendar-check"></i>
                    </div>

                    <div class="role-content">

                        <h3>
                            Organizacija događaja
                        </h3>

                        <p>
                            Pomozi u pripremi i provedbi druženja,
                            događaja i drugih aktivnosti koje klub
                            organizira za svoje članove.
                        </p>

                    </div>

                </div>


                @* PROMOCIJA *@
                <div class="role-card">

                    <div class="role-icon">
                        <i class="ph ph-megaphone"></i>
                    </div>

                    <div class="role-content">

                        <h3>
                            Promocija i sadržaj
                        </h3>

                        <p>
                            Ako voliš društvene mreže, fotografiju,
                            video ili dizajn, možeš pomoći u predstavljanju
                            kluba i njegovih aktivnosti.
                        </p>

                    </div>

                </div>


                @* PROJEKTI *@
                <div class="role-card">

                    <div class="role-icon">
                        <i class="ph ph-rocket-launch"></i>
                    </div>

                    <div class="role-content">

                        <h3>
                            Projekti i nove ideje
                        </h3>

                        <p>
                            Imaš ideju za novu aktivnost ili projekt?
                            Kao volonter možeš sudjelovati u razvoju
                            novih inicijativa kluba.
                        </p>

                    </div>

                </div>


                @* PODRŠKA *@
                <div class="role-card">

                    <div class="role-icon">
                        <i class="ph ph-handshake"></i>
                    </div>

                    <div class="role-content">

                        <h3>
                            Podrška klubu
                        </h3>

                        <p>
                            Pomozi ekipi tamo gdje je potrebno i
                            sudjeluj u svakodnevnim aktivnostima
                            koje omogućuju da klub funkcionira.
                        </p>

                    </div>

                </div>

            </div>

        </div>
    </section>

    @* ============================= *@
    @* GALERIJA                      *@
    @* ============================= *@

    <section class="volunteer-section">
        <div class="container">

            <div class="section-heading text-center">

                <span class="section-eyebrow">
                    Naša ekipa
                </span>

                <h2>
                    Kako to izgleda?
                </h2>

                <p>
                    Najbolji dio volontiranja su ljudi, iskustva
                    i stvari koje zajedno stvaramo.
                </p>

            </div>


            <div class="volunteer-gallery-categories">

                @* ============================= *@
                @* DOGAĐAJI                      *@
                @* ============================= *@

                <div class="gallery-category-card">

                    <div class="gallery-category-header">

                        <div class="gallery-category-icon">
                            <i class="ph ph-calendar-check"></i>
                        </div>

                        <div>
                            <h3>Događaji</h3>

                            <p>
                                Pogledaj kako izgledaju naši događaji
                                i sve što zajedno organiziramo.
                            </p>
                        </div>

                    </div>


                    <div class="gallery-image-wrapper">

                        <img src="@EventsImages[_eventsIndex]"
                             alt="Događaji kluba"
                             class="gallery-main-image"/>

                        @if (EventsImages.Length > 1)
                        {
                            <button type="button"
                                    class="gallery-nav gallery-nav-left"
                                    aria-label="Prethodna fotografija"
                                    @onclick="PreviousEventImage">

                                <i class="ph ph-caret-left"></i>

                            </button>

                            <button type="button"
                                    class="gallery-nav gallery-nav-right"
                                    aria-label="Sljedeća fotografija"
                                    @onclick="NextEventImage">

                                <i class="ph ph-caret-right"></i>

                            </button>
                        }


                        <div class="gallery-counter">
                            @(_eventsIndex + 1) / @EventsImages.Length
                        </div>

                    </div>


                    <div class="gallery-thumbnails">

                        @for (var i = 0; i < EventsImages.Length; i++)
                        {
                            var index = i;

                            <button type="button"
                                    class="@GetThumbnailClass(index, _eventsIndex)"
                                    @onclick="@(() => _eventsIndex = index)">

                                <img src="@EventsImages[index]"
                                     alt="Fotografija događaja"/>

                            </button>
                        }

                    </div>

                </div>


                @* ============================= *@
                @* NAŠA EKIPA                    *@
                @* ============================= *@

                <div class="gallery-category-card">

                    <div class="gallery-category-header">

                        <div class="gallery-category-icon">
                            <i class="ph ph-users-three"></i>
                        </div>

                        <div>
                            <h3>Naša ekipa</h3>

                            <p>
                                Upoznaj dio naše volonterske ekipe
                                i atmosferu u klubu.
                            </p>
                        </div>

                    </div>


                    <div class="gallery-image-wrapper">

                        <img src="@TeamImages[_teamIndex]"
                             alt="Volonterska ekipa"
                             class="gallery-main-image"/>

                        @if (TeamImages.Length > 1)
                        {
                            <button type="button"
                                    class="gallery-nav gallery-nav-left"
                                    aria-label="Prethodna fotografija"
                                    @onclick="PreviousTeamImage">

                                <i class="ph ph-caret-left"></i>

                            </button>

                            <button type="button"
                                    class="gallery-nav gallery-nav-right"
                                    aria-label="Sljedeća fotografija"
                                    @onclick="NextTeamImage">

                                <i class="ph ph-caret-right"></i>

                            </button>
                        }


                        <div class="gallery-counter">
                            @(_teamIndex + 1) / @TeamImages.Length
                        </div>

                    </div>


                    <div class="gallery-thumbnails">

                        @for (var i = 0; i < TeamImages.Length; i++)
                        {
                            var index = i;

                            <button type="button"
                                    class="@GetThumbnailClass(index, _teamIndex)"
                                    @onclick="@(() => _teamIndex = index)">

                                <img src="@TeamImages[index]"
                                     alt="Fotografija ekipe"/>

                            </button>
                        }

                    </div>

                </div>


                @* ============================= *@
                @* AKTIVNOSTI                    *@
                @* ============================= *@

                <div class="gallery-category-card">

                    <div class="gallery-category-header">

                        <div class="gallery-category-icon">
                            <i class="ph ph-confetti"></i>
                        </div>

                        <div>
                            <h3>Aktivnosti</h3>

                            <p>
                                Sport, druženja i ostale aktivnosti
                                koje organiziramo kroz godinu.
                            </p>
                        </div>

                    </div>


                    <div class="gallery-image-wrapper">

                        <img src="@ActivityImages[_activityIndex]"
                             alt="Aktivnosti kluba"
                             class="gallery-main-image"/>

                        @if (ActivityImages.Length > 1)
                        {
                            <button type="button"
                                    class="gallery-nav gallery-nav-left"
                                    aria-label="Prethodna fotografija"
                                    @onclick="PreviousActivityImage">

                                <i class="ph ph-caret-left"></i>

                            </button>

                            <button type="button"
                                    class="gallery-nav gallery-nav-right"
                                    aria-label="Sljedeća fotografija"
                                    @onclick="NextActivityImage">

                                <i class="ph ph-caret-right"></i>

                            </button>
                        }


                        <div class="gallery-counter">
                            @(_activityIndex + 1) / @ActivityImages.Length
                        </div>

                    </div>


                    <div class="gallery-thumbnails">

                        @for (var i = 0; i < ActivityImages.Length; i++)
                        {
                            var index = i;

                            <button type="button"
                                    class="@GetThumbnailClass(index, _activityIndex)"
                                    @onclick="@(() => _activityIndex = index)">

                                <img src="@ActivityImages[index]"
                                     alt="Fotografija aktivnosti"/>

                            </button>
                        }

                    </div>

                </div>

            </div>

        </div>
    </section>
    <section class="volunteer-section">
        <div class="container">

            <div class="join-card">

                <div class="join-icon">
                    <i class="ph ph-beer-bottle"></i>
                </div>

                <div class="join-content">

                    <span class="section-eyebrow">
                        Zainteresiran/a?
                    </span>

                    <h2>
                        Pridruži se našim volonterima
                    </h2>

                    <p>
                        Ne trebaš imati iskustvo niti unaprijed znati
                        čime se želiš baviti. Javi nam se, upoznat ćemo
                        te s ekipom i pronaći nešto što ti odgovara.
                    </p>

                </div>

                <div class="join-action">

                    <a href="https://www.instagram.com/ksi.matebalota"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="btn btn-primary btn-lg d-flex align-items-center justify-content-center">

                        <i class="ph ph-instagram-logo me-2"></i>
                        Javi nam se na Instagramu
                    </a>

                </div>

            </div>

        </div>
    </section>

    <section class="pb-5">
        <div class="container text-center">

            <a href="javascript:history.back()"
               class="btn btn-link text-decoration-none d-flex align-items-center justify-content-center">

                <i class="ph ph-arrow-left me-1"></i>
                Povratak na profil
            </a>

        </div>
    </section>

</div>

@code{


    private static readonly string[] EventsImages =
    [
        "/images/koncert.jpeg",
        "/images/fullhouse.jpeg"
    ];

    private static readonly string[] TeamImages =
    [
        "/images/grupna-1.jpeg",
        "/images/team-building.jpeg"
    ];

    private static readonly string[] ActivityImages =
    [
        "/images/futsal.jpeg",
        "/images/stolni.jpeg",
        "/images/dj.jpeg",
    ];


    private int _eventsIndex;
    private int _teamIndex;
    private int _activityIndex;


    private void NextEventImage()
    {
        _eventsIndex =
            (_eventsIndex + 1) % EventsImages.Length;
    }

    private void PreviousEventImage()
    {
        _eventsIndex =
            (_eventsIndex - 1 + EventsImages.Length)
            % EventsImages.Length;
    }


    private void NextTeamImage()
    {
        _teamIndex =
            (_teamIndex + 1) % TeamImages.Length;
    }

    private void PreviousTeamImage()
    {
        _teamIndex =
            (_teamIndex - 1 + TeamImages.Length)
            % TeamImages.Length;
    }


    private void NextActivityImage()
    {
        _activityIndex =
            (_activityIndex + 1) % ActivityImages.Length;
    }

    private void PreviousActivityImage()
    {
        _activityIndex =
            (_activityIndex - 1 + ActivityImages.Length)
            % ActivityImages.Length;
    }


    private static string GetThumbnailClass(
        int index,
        int currentIndex)
    {
        return index == currentIndex
            ? "gallery-thumbnail active"
            : "gallery-thumbnail";
    }

}